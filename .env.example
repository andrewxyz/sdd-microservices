# Copy to .env and replace every value. .env is git-ignored; this file is committed and must never
# contain a real secret (FR-009, SC-010).
#
# EUREKA_URL and CONFIG_SERVER_URL are deliberately absent: docker-compose.yml builds them from the
# internal container names and the credentials below, so a password is never written in two places.

# Which profile the services run under. "local" means no login on the registry and config server.
SPRING_PROFILES_ACTIVE=local

# Registry (Eureka) basic auth, required outside the local profile.
EUREKA_USER=eureka
EUREKA_PASSWORD=change-me-eureka

# Config server basic auth, and the credentials its clients use.
CONFIG_USER=config
CONFIG_PASSWORD=change-me-config

# PostgreSQL superuser, used only to create the per-service roles and databases.
POSTGRES_USER=learnhub
POSTGRES_PASSWORD=change-me-postgres

# One login per planned business service. Each owns its own database (constitution Principle II).
AUTH_DB_PASSWORD=change-me-auth
COURSE_DB_PASSWORD=change-me-course
ENROLLMENT_DB_PASSWORD=change-me-enrollment
PAYMENT_DB_PASSWORD=change-me-payment
CERTIFICATE_DB_PASSWORD=change-me-certificate
REVIEW_DB_PASSWORD=change-me-review
NOTIFICATION_DB_PASSWORD=change-me-notification
ANALYTICS_DB_PASSWORD=change-me-analytics

# RabbitMQ broker credentials.
RABBITMQ_DEFAULT_USER=learnhub
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# auth-service: HS256 secret shared by auth-service (signs) and api-gateway (verifies) access tokens.
# Must be at least 32 bytes.
JWT_SIGNING_SECRET=change-me-jwt-signing-secret-32-bytes-minimum

# auth-service: the first administrator account, created once at startup if no administrator exists yet.
ADMIN_EMAIL=admin@learnhub.example
ADMIN_PASSWORD=change-me-admin-password-1

# frontend: the gateway URL the nginx container proxies /api/ to. Not a secret; the default already
# matches the compose network, so this is only needed if that ever changes.
GATEWAY_URL=http://api-gateway:9080
