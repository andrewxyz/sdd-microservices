{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnhub.example/schemas/certificate-issued.event.schema.json",
  "title": "certificate.issued payload",
  "description": "The 'payload' content of an EventEnvelope whose 'type' is 'certificate.issued', version 1. Published by certificate-service (research.md R6, R7); consumed by notification-service (research.md R6). Deliberately carries no course title — notification-service fetches it fresh from course-service (research.md R3, R5).",
  "type": "object",
  "required": ["certificateId", "userId", "courseId", "verificationCode", "issuedAt"],
  "properties": {
    "certificateId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "courseId": { "type": "string", "format": "uuid" },
    "verificationCode": { "type": "string", "pattern": "^[A-Z0-9]{16}$" },
    "issuedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "certificateId": "0b8f5c1e-3a42-4d1e-9c77-5a2d6e8f0b19",
      "userId": "9f8e7d6c-5b4a-4930-8271-6a5b4c3d2e1f",
      "courseId": "7a5e9c3d-2b1f-4a60-8e77-1d3c5f9a0b22",
      "verificationCode": "7K9M4PQRS2N8X3WT",
      "issuedAt": "2026-10-19T10:15:05Z"
    }
  ]
}
