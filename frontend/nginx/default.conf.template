# Processed by the nginx:alpine entrypoint (envsubst). The compose service sets
# NGINX_ENVSUBST_TEMPLATE_VARS=GATEWAY_URL so only ${GATEWAY_URL} is substituted;
# nginx variables ($uri, $host, etc.) are passed through unchanged (research R13).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location /api/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
